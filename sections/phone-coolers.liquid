<section class="py-14 bg-gray-50 border-b border-gray-200" id="phonecooler">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <div class="flex items-center justify-center gap-4">
        <div class="h-[1px] bg-gray-300 w-16 sm:w-32"></div>
        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-wider uppercase font-montserrat">GAMING ACCESSORIES &amp; PHONE COOLERS</h2>
        <div class="h-[1px] bg-gray-300 w-16 sm:w-32"></div>
      </div>
      <p class="text-xs text-gray-500 font-semibold uppercase tracking-wider mt-1.5">Semiconductor Peltier Cooling &bull; Eliminates PUBG/FreeFire FPS Drops &bull; Down to 5°C in Seconds</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-3 gap-6">
      <!-- Cooler 1: Magnetic RGB -->
      <div class="bg-white border border-gray-200 rounded-xl p-5 flex flex-col justify-between hover:shadow-xl transition-all group">
        <div class="relative overflow-hidden bg-slate-900 rounded-lg mb-4 aspect-square flex items-center justify-center p-4">
          <span class="absolute top-2 left-2 z-10 bg-teal-400 text-black text-[9px] font-black uppercase px-2 py-0.5 rounded">TURBO FAN</span>
          <div class="w-24 h-24 bg-slate-950 rounded-full border-2 border-teal-400 shadow-xl flex items-center justify-center group-hover:rotate-180 transition-transform duration-700">
            <i class="fa-solid fa-fan text-teal-400 text-4xl animate-spin" style="animation-duration: 5s;"></i>
          </div>
          <button class="absolute bottom-2 inset-x-2 bg-black/80 hover:bg-brandTeal text-white text-[11px] font-bold py-2 rounded uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer" onclick="openQuickView('TechTracker Semiconductor Gaming Phone Cooler (Magnetic RGB)', 'Rs.2,500.00', 'Gaming Accessories', 'Instant peltier semiconductor cooling down to 5°C, vibrant RGB illumination, magnetic snap-on and clamp-on dual mounting, silent 6000 RPM turbofan preventing FPS drop.')">
            Quick View
          </button>
        </div>
        <div class="text-center">
          <span class="text-[10px] text-gray-400 uppercase tracking-widest font-semibold block mb-1">TECH TRACKER</span>
          <h3 class="text-sm font-bold text-gray-800 line-clamp-1">Magnetic RGB Semiconductor Cooler</h3>
          <p class="text-xs text-gray-500 mt-1">Instant cooling with silent 6000 RPM turbofan</p>
          <div class="flex items-center justify-center gap-2 mt-2">
            <span class="text-xs text-gray-400 line-through font-semibold">Rs.3,800.00</span>
            <span class="text-base font-extrabold text-saleRed">Rs.2,500.00</span>
          </div>
          <button class="mt-3 w-full border border-gray-800 hover:bg-black hover:text-white text-gray-900 text-xs font-bold py-1.5 rounded uppercase tracking-wider transition-colors cursor-pointer" onclick="addToCart('TechTracker Semiconductor Gaming Phone Cooler (Magnetic RGB)', 2500)">
            Add to Cart
          </button>
        </div>
      </div>

      <!-- Cooler 2: DL05 Temp Display -->
      <div class="bg-white border border-gray-200 rounded-xl p-5 flex flex-col justify-between hover:shadow-xl transition-all group">
        <div class="relative overflow-hidden bg-slate-900 rounded-lg mb-4 aspect-square flex items-center justify-center p-4">
          <span class="absolute top-2 left-2 z-10 bg-blue-500 text-white text-[9px] font-black uppercase px-2 py-0.5 rounded">TEMP MONITOR</span>
          <div class="w-24 h-24 bg-slate-950 rounded-2xl border-2 border-blue-400 shadow-xl flex flex-col items-center justify-center p-2">
            <span class="text-xl font-mono font-black text-cyan-300">08°C</span>
            <span class="text-[7px] text-gray-400 mt-1">REAL-TIME TEMP</span>
          </div>
          <button class="absolute bottom-2 inset-x-2 bg-black/80 hover:bg-brandTeal text-white text-[11px] font-bold py-2 rounded uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer" onclick="openQuickView('TechTracker MEMO DL05 Digital Temp Display Phone Cooler', 'Rs.2,999.00', 'Gaming Accessories', 'Live real-time digital LED temperature display showing degrees Celsius right on the cooler back. Freezes down in 10 seconds, dual silicone non-slip clamp.')">
            Quick View
          </button>
        </div>
        <div class="text-center">
          <span class="text-[10px] text-gray-400 uppercase tracking-widest font-semibold block mb-1">TECH TRACKER</span>
          <h3 class="text-sm font-bold text-gray-800 line-clamp-1">MEMO DL05 Digital Temp Display</h3>
          <p class="text-xs text-gray-500 mt-1">Live LED degrees monitoring &amp; anti-slip clamp</p>
          <div class="flex items-center justify-center gap-2 mt-2">
            <span class="text-xs text-gray-400 line-through font-semibold">Rs.4,500.00</span>
            <span class="text-base font-extrabold text-saleRed">Rs.2,999.00</span>
          </div>
          <button class="mt-3 w-full border border-gray-800 hover:bg-black hover:text-white text-gray-900 text-xs font-bold py-1.5 rounded uppercase tracking-wider transition-colors cursor-pointer" onclick="addToCart('TechTracker MEMO DL05 Digital Temp Display Phone Cooler', 2999)">
            Add to Cart
          </button>
        </div>
      </div>

      <!-- Cooler 3: Dual Peltier Extreme -->
      <div class="bg-white border border-gray-200 rounded-xl p-5 flex flex-col justify-between hover:shadow-xl transition-all group">
        <div class="relative overflow-hidden bg-slate-900 rounded-lg mb-4 aspect-square flex items-center justify-center p-4">
          <span class="absolute top-2 left-2 z-10 bg-purple-500 text-white text-[9px] font-black uppercase px-2 py-0.5 rounded">DUAL PELTIER</span>
          <div class="w-24 h-24 bg-slate-950 rounded-full border-2 border-purple-400 shadow-xl flex flex-col items-center justify-center p-2">
            <i class="fa-solid fa-snowflake text-purple-400 text-3xl animate-pulse"></i>
            <span class="text-[7px] text-purple-300 font-mono font-bold mt-1">MAGSAFE SNAP</span>
          </div>
          <button class="absolute bottom-2 inset-x-2 bg-black/80 hover:bg-brandTeal text-white text-[11px] font-bold py-2 rounded uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer" onclick="openQuickView('TechTracker Black Shark Style Dual Peltier Magnetic Radiator', 'Rs.3,200.00', 'Gaming Accessories', 'Heavy-duty dual-layer semiconductor Peltier plate cooling module. Perfect for iPhone MagSafe direct snap and Android devices. Eliminates 90FPS thermal throttling.')">
            Quick View
          </button>
        </div>
        <div class="text-center">
          <span class="text-[10px] text-gray-400 uppercase tracking-widest font-semibold block mb-1">TECH TRACKER</span>
          <h3 class="text-sm font-bold text-gray-800 line-clamp-1">Dual Peltier Magnetic Radiator</h3>
          <p class="text-xs text-gray-500 mt-1">iPhone MagSafe &amp; Android dual compatibility</p>
          <div class="flex items-center justify-center gap-2 mt-2">
            <span class="text-xs text-gray-400 line-through font-semibold">Rs.4,800.00</span>
            <span class="text-base font-extrabold text-saleRed">Rs.3,200.00</span>
          </div>
          <button class="mt-3 w-full border border-gray-800 hover:bg-black hover:text-white text-gray-900 text-xs font-bold py-1.5 rounded uppercase tracking-wider transition-colors cursor-pointer" onclick="addToCart('TechTracker Black Shark Style Dual Peltier Magnetic Radiator', 3200)">
            Add to Cart
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Phone Coolers",
  "settings": []
}
{% endschema %}
