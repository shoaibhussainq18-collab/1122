<section class="py-12 bg-white" id="newarrivals">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <div class="flex items-center justify-center gap-4">
        <div class="h-[1px] bg-gray-300 w-16 sm:w-32"></div>
        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-wider uppercase font-montserrat">NEW ARRIVALS</h2>
        <div class="h-[1px] bg-gray-300 w-16 sm:w-32"></div>
      </div>
      <p class="text-xs text-gray-500 font-semibold uppercase tracking-wider mt-1.5">Latest 2026 Smartwatches with Calling &amp; Fitness Sensors</p>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      <!-- Product 1 -->
      <div class="bg-white border border-gray-100 rounded-md p-3 sm:p-4 flex flex-col justify-between hover:shadow-xl transition-all group">
        <div class="relative overflow-hidden bg-gray-50 rounded-md mb-3 aspect-square flex items-center justify-center">
          <div class="w-full h-full flex flex-col items-center justify-center p-3 relative group-hover:scale-105 transition-transform">
            <div class="flex gap-2 items-center justify-center">
              <div class="w-4 h-24 bg-emerald-200 rounded-full"></div>
              <div class="w-4 h-24 bg-rose-200 rounded-full"></div>
              <div class="w-4 h-24 bg-blue-900 rounded-full"></div>
              <div class="w-4 h-24 bg-zinc-900 rounded-full"></div>
            </div>
            <div class="absolute bg-zinc-900 border-2 border-zinc-700 w-16 h-20 rounded-2xl flex items-center justify-center text-[9px] text-brandCyan font-mono">
              Z90 PRO
            </div>
          </div>
          <button class="absolute bottom-2 inset-x-2 bg-black/80 hover:bg-brandTeal text-white text-[11px] font-bold py-2 rounded uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity" onclick="openQuickView('Z90 Pro Smart Watch', 'Rs.4,000.00', 'Smartwatch', 'Includes 4 multi-color interchangeable silicone straps.')">
            Quick View
          </button>
        </div>
        <div class="text-center">
          <span class="text-[10px] text-gray-400 uppercase tracking-widest font-semibold block mb-1">TECH TRACKER</span>
          <h3 class="text-xs sm:text-sm font-semibold text-gray-800 line-clamp-2">Z90 Pro Smart Watch</h3>
          <p class="text-sm sm:text-base font-extrabold text-gray-900 mt-2">Rs.4,000.00</p>
          <button class="mt-3 w-full border border-gray-800 hover:bg-black hover:text-white text-gray-900 text-xs font-bold py-1.5 rounded uppercase tracking-wider transition-colors cursor-pointer" onclick="addToCart('Z90 Pro Smart Watch', 4000)">
            Add to Cart
          </button>
        </div>
      </div>

      <!-- Product 2 -->
      <div class="bg-white border border-gray-100 rounded-md p-3 sm:p-4 flex flex-col justify-between hover:shadow-xl transition-all group">
        <div class="relative overflow-hidden bg-gray-50 rounded-md mb-3 aspect-square flex items-center justify-center">
          <div class="w-full h-full flex flex-col items-center justify-center relative group-hover:scale-105 transition-transform">
            <div class="w-20 h-28 bg-red-600 rounded-2xl p-1 shadow-lg flex items-center justify-center">
              <div class="w-16 h-20 bg-black rounded-xl border border-red-400 flex flex-col items-center justify-center text-center p-1">
                <span class="text-[7px] text-white uppercase font-bold">Series 9</span>
                <span class="text-xs text-red-500 font-mono font-bold mt-1">2.1"</span>
              </div>
            </div>
          </div>
          <button class="absolute bottom-2 inset-x-2 bg-black/80 hover:bg-brandTeal text-white text-[11px] font-bold py-2 rounded uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity" onclick="openQuickView('Z81 Pro - Max Series 9 2.1&quot; Smart Watch', 'Rs.5,000.00', 'Smartwatch', 'Max 2.1 OLED display with calling.')">
            Quick View
          </button>
        </div>
        <div class="text-center">
          <span class="text-[10px] text-gray-400 uppercase tracking-widest font-semibold block mb-1">TECH TRACKER</span>
          <h3 class="text-xs sm:text-sm font-semibold text-gray-800 line-clamp-2">Z81 Pro - Max Series 9 2.1" Smart Watch</h3>
          <p class="text-sm sm:text-base font-extrabold text-gray-900 mt-2">Rs.5,000.00</p>
          <button class="mt-3 w-full border border-gray-800 hover:bg-black hover:text-white text-gray-900 text-xs font-bold py-1.5 rounded uppercase tracking-wider transition-colors cursor-pointer" onclick="addToCart('Z81 Pro - Max Series 9 2.1&quot; Smart Watch', 5000)">
            Add to Cart
          </button>
        </div>
      </div>

      <!-- Product 3 -->
      <div class="bg-white border border-gray-100 rounded-md p-3 sm:p-4 flex flex-col justify-between hover:shadow-xl transition-all group">
        <div class="relative overflow-hidden bg-gray-50 rounded-md mb-3 aspect-square flex items-center justify-center">
          <div class="w-full h-full flex flex-col items-center justify-center p-4 relative group-hover:scale-105 transition-transform">
            <div class="w-24 h-24 bg-gradient-to-tr from-slate-900 to-slate-700 rounded-xl p-2 shadow-lg flex flex-col justify-between border border-slate-600">
              <div class="text-[7px] text-teal-300 font-bold uppercase">Z80 Pro Retail Pack</div>
              <div class="w-12 h-12 self-center bg-black rounded-lg border border-teal-400 flex items-center justify-center text-teal-400 text-xs font-mono">
                <i class="fa-solid fa-heart-pulse animate-pulse"></i>
              </div>
              <div class="text-[6px] text-gray-400 text-right">HD SOUND</div>
            </div>
          </div>
          <button class="absolute bottom-2 inset-x-2 bg-black/80 hover:bg-brandTeal text-white text-[11px] font-bold py-2 rounded uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity" onclick="openQuickView('Z80 Pro Smart Watch', 'Rs.4,500.00', 'Smartwatch', 'Retail pack with magnetic charger.')">
            Quick View
          </button>
        </div>
        <div class="text-center">
          <span class="text-[10px] text-gray-400 uppercase tracking-widest font-semibold block mb-1">TECH TRACKER</span>
          <h3 class="text-xs sm:text-sm font-semibold text-gray-800 line-clamp-2">Z80 Pro Smart Watch</h3>
          <p class="text-sm sm:text-base font-extrabold text-gray-900 mt-2">Rs.4,500.00</p>
          <button class="mt-3 w-full border border-gray-800 hover:bg-black hover:text-white text-gray-900 text-xs font-bold py-1.5 rounded uppercase tracking-wider transition-colors cursor-pointer" onclick="addToCart('Z80 Pro Smart Watch', 4500)">
            Add to Cart
          </button>
        </div>
      </div>

      <!-- Product 4 -->
      <div class="bg-white border border-gray-100 rounded-md p-3 sm:p-4 flex flex-col justify-between hover:shadow-xl transition-all group">
        <div class="relative overflow-hidden bg-gray-50 rounded-md mb-3 aspect-square flex items-center justify-center">
          <div class="w-full h-full flex flex-col items-center justify-center relative group-hover:scale-105 transition-transform">
            <div class="w-10 h-6 bg-orange-500 rounded-t-md"></div>
            <div class="w-24 h-28 bg-slate-300 rounded-3xl p-1.5 shadow-xl border-2 border-slate-400 flex items-center justify-center">
              <div class="w-full h-full bg-black rounded-2xl flex flex-col items-center justify-center text-center p-1 relative">
                <span class="text-xs text-white font-mono font-bold">10:09</span>
                <span class="text-[8px] text-teal-400 font-mono">49MM TITANIUM</span>
              </div>
            </div>
            <div class="w-10 h-8 bg-orange-500 rounded-b-md"></div>
          </div>
          <button class="absolute bottom-2 inset-x-2 bg-black/80 hover:bg-brandTeal text-white text-[11px] font-bold py-2 rounded uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity" onclick="openQuickView('Ultra 2 Watch 49mm Titanium Case', 'Rs.3,000.00', 'Smartwatch', '49mm titanium case with ocean band.')">
            Quick View
          </button>
        </div>
        <div class="text-center">
          <span class="text-[10px] text-gray-400 uppercase tracking-widest font-semibold block mb-1">TECH TRACKER</span>
          <h3 class="text-xs sm:text-sm font-semibold text-gray-800 line-clamp-2">Ultra 2 Watch 49mm Titanium Case (Ocean Band)</h3>
          <p class="text-sm sm:text-base font-extrabold text-gray-900 mt-2">Rs.3,000.00</p>
          <button class="mt-3 w-full border border-gray-800 hover:bg-black hover:text-white text-gray-900 text-xs font-bold py-1.5 rounded uppercase tracking-wider transition-colors cursor-pointer" onclick="addToCart('Ultra 2 Watch 49mm Titanium Case (Ocean Band)', 3000)">
            Add to Cart
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "New Arrivals",
  "settings": []
}
{% endschema %}
