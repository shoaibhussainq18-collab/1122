<section class="hero-banner-bg border-b border-gray-200 relative overflow-hidden py-10 sm:py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="hidden lg:flex lg:col-span-5 relative items-center justify-center">
        <div class="relative w-80 h-80 sm:w-96 sm:h-96">
          <div class="absolute inset-0 bg-teal-200/40 rounded-full blur-3xl transform scale-90"></div>
          <div class="relative z-10 w-full h-full flex items-center justify-center filter drop-shadow-2xl">
            <svg class="w-full h-full" viewbox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
              <polygon fill="#e5e7eb" points="120,40 280,40 360,120 360,280 280,360 120,360 40,280 40,120" stroke="#9ca3af" stroke-width="5"></polygon>
              <circle cx="200" cy="200" fill="#18181b" r="140" stroke="#64748b" stroke-width="8"></circle>
              <circle cx="200" cy="200" fill="#09090b" r="125"></circle>
              <text fill="#f8fafc" font-family="Montserrat" font-size="16" font-weight="900" letter-spacing="3" text-anchor="middle" x="200" y="130">HUBLOT</text>
              <text fill="#94a3b8" font-family="Montserrat" font-size="8" letter-spacing="2" text-anchor="middle" x="200" y="145">GENEVE</text>
              <line stroke="#f1f5f9" stroke-linecap="round" stroke-width="5" x1="200" x2="145" y1="200" y2="150"></line>
              <line stroke="#f1f5f9" stroke-linecap="round" stroke-width="4" x1="200" x2="260" y1="200" y2="130"></line>
              <line stroke="#00c2b2" stroke-linecap="round" stroke-width="2" x1="200" x2="200" y1="200" y2="80"></line>
              <circle cx="200" cy="200" fill="#00c2b2" r="6"></circle>
            </svg>
          </div>
        </div>
      </div>

      <div class="col-span-1 lg:col-span-4 text-center lg:text-left flex flex-col items-center lg:items-start z-20">
        <span class="text-xs font-extrabold uppercase tracking-[0.3em] text-teal-700 bg-teal-100/80 px-3 py-1 rounded-full mb-3">
          Master Edition 2026
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-gray-900 tracking-tight leading-none mb-3 italic">
          HUBLOT
        </h1>
        <p class="text-xl sm:text-2xl lg:text-3xl font-bold text-gray-800 tracking-widest uppercase mb-6 font-montserrat">
          TELL IT YOUR WAY
        </p>
        <p class="text-sm text-gray-600 mb-8 max-w-sm">
          Discover unparalleled skeleton chronographs, mechanical luxury replicas, and smart precision timepieces with Cash On Delivery.
        </p>
        <div class="flex items-center gap-3">
          <a class="inline-block bg-black text-white hover:bg-brandTeal hover:text-black font-extrabold text-sm uppercase px-8 py-3.5 tracking-widest transition-all duration-300 transform hover:-translate-y-0.5 shadow-lg" href="#watches">
            SHOP HUBLOT
          </a>
          <a class="inline-block bg-brandTeal text-gray-950 hover:bg-black hover:text-white font-extrabold text-sm uppercase px-8 py-3.5 tracking-widest transition-all duration-300 shadow-md" href="#newarrivals">
            NEW ARRIVALS
          </a>
        </div>
      </div>

      <div class="hidden sm:flex lg:col-span-3 items-center justify-center">
        <div class="relative w-72 h-80 flex flex-col items-center">
          <div class="w-24 h-16 bg-zinc-900 rounded-t-lg shadow-inner"></div>
          <div class="w-48 h-48 bg-gradient-to-tr from-gray-300 via-gray-100 to-gray-400 rounded-2xl p-2.5 shadow-2xl flex items-center justify-center border border-gray-400">
            <div class="w-full h-full bg-black rounded-xl p-2 relative flex flex-col items-center justify-center overflow-hidden">
              <div class="text-[10px] font-black text-white tracking-widest">HUBLOT</div>
              <div class="flex gap-2 my-2">
                <div class="w-8 h-8 rounded-full border border-gray-600 bg-zinc-900"></div>
                <div class="w-8 h-8 rounded-full border border-gray-600 bg-zinc-900"></div>
              </div>
              <div class="text-[8px] text-teal-400 font-mono font-bold tracking-wider">GENEVE AUTOMATIC</div>
            </div>
          </div>
          <div class="w-24 h-20 bg-zinc-900 rounded-b-xl shadow-inner mt-0.5"></div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": []
}
{% endschema %}
